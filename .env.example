# Copy this file to .env.local and fill in the value. .env.local is gitignored.
# Get a free access key at https://web3forms.com (verify your inbox email).
# Note: on the free plan Web3Forms only accepts client-side submissions, so this
# is a NEXT_PUBLIC_ var and is visible in the browser (public-by-design key).
# In production, set this in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_WEB3FORMS_KEY=7778af33-889a-4e62-9f3c-d6c0f51ea785
